[Unit]
Description=CultureLive FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/culturelive
EnvironmentFile=/opt/culturelive/.env
Environment=PYTHONPATH=/opt/culturelive
ExecStart=/opt/culturelive/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

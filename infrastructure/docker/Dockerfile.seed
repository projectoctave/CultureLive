FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY backend ./backend
COPY integration ./integration
COPY referential ./referential
COPY tests ./tests
COPY infrastructure/scripts ./infrastructure/scripts

RUN pip install --no-cache-dir -U pip && pip install --no-cache-dir ".[dev]"

ENV PYTHONPATH=/app
CMD ["python", "infrastructure/scripts/seed_demo_data.py"]

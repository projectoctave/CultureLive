# --- Base de données ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cultur_live:cultur_live@localhost:5432/cultur_live
POSTGRES_USER=cultur_live
POSTGRES_PASSWORD=cultur_live
POSTGRES_DB=cultur_live

# --- Secrets applicatifs (OBLIGATOIRES : l'API refuse de démarrer sans eux) -----
# Clé admin : protège /meetings, /classify/sync, /referential et donne l'accès stats global.
# Générer : openssl rand -hex 24
DASHBOARD_API_KEY=
# Signature des sessions de login du dashboard (32 caractères minimum). Générer : openssl rand -hex 32
JWT_SECRET=

# --- Google Calendar -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Chiffre les refresh tokens en base (16 caractères minimum). Générer : openssl rand -hex 24
TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# --- Classification IA (optionnel : sinon heuristiques sur mots-clés) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Worker de synchronisation périodique --------------------------------------
SYNC_INTERVAL_MINUTES=15
SYNC_LOOKBACK_DAYS=7
SYNC_LOOKAHEAD_DAYS=30

# --- Infrastructure Docker / Let's Encrypt -------------------------------------
DOMAIN_NAME=culturelive.example.com
LETSENCRYPT_EMAIL=admin@example.com
# true = certificat de test Let's Encrypt (évite les limites de débit pendant les essais)
LETSENCRYPT_STAGING=false
